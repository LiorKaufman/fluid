{
  "id": "reading-room",
  "name": "The reading room",
  "description": "A slower, editorial view of the things on your mind.",
  "author": "Fluid community",
  "appId": "org.fluidprotocol.workspace",
  "protocol": "0.1",
  "permissions": ["tasks:read"],
  "html": "<style>\n  body { margin: 0; padding: 56px 10%; color: #403c31; background: #f7f1e5; font-family: Georgia, serif; }\n  header { border-bottom: 1px solid #ccc1ab; padding-bottom: 32px; margin-bottom: 35px; }\n  header small { font: 10px system-ui; letter-spacing: 2px; color: #92846b; }\n  h1 { font-weight: 400; font-size: 52px; letter-spacing: -2px; margin: 20px 0; }\n  header p { font-size: 17px; line-height: 1.7; color: #92846b; }\n  article { padding: 23px 0; border-bottom: 1px solid #ddd2bf; }\n  article small { font: 10px system-ui; text-transform: uppercase; letter-spacing: 1px; color: #a2947b; }\n  article h2 { font-size: 23px; line-height: 1.5; font-weight: 400; margin: 12px 0; }\n  article p { color: #998970; line-height: 1.8; font-size: 15px; }\n  article.done h2 { text-decoration: line-through; color: #b3a68e; }\n  #error { font: 14px system-ui; line-height: 1.8; color: #a66c4d; }\n</style>\n<header><small>A DIFFERENT POINT OF VIEW</small><h1>The reading room.</h1><p>A slower look at the things on your mind.<br>Same workspace. A little more room to think.</p></header>\n<main id=\"tasks\"></main><p id=\"error\" role=\"status\"></p>\n<script>\n  async function refresh() {\n    try {\n      const { tasks } = await fluid.call('tasks.list');\n      const container = document.getElementById('tasks'); container.replaceChildren();\n      for (const task of tasks) {\n        const article = document.createElement('article'); article.className = task.status;\n        const project = document.createElement('small'); project.textContent = task.project + ' / ' + task.status;\n        const title = document.createElement('h2'); title.textContent = task.title;\n        const notes = document.createElement('p'); notes.textContent = task.notes;\n        article.append(project, title, notes); container.append(article);\n      }\n      document.getElementById('error').textContent = '';\n    } catch (error) { document.getElementById('error').textContent = error.message; }\n  }\n  fluid.subscribe(refresh); refresh();\n</script>"
}
